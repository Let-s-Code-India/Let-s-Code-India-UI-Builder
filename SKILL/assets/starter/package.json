{
  "name": "let-s-code-india-ui-starter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Starter for Let-s-Code-India-UI-Builder: Vite + React + TypeScript + Tailwind CSS v4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "theme": "python3 ../../scripts/tokens_to_tailwind.py --palette clean-minimalist-saas --default system --out src/theme.css",
    "lint:ui": "python3 ../../scripts/lint_ui.py src index.html",
    "check:classes": "node ../../scripts/check_classes.mjs src index.html",
    "check": "npm run lint:ui && npm run check:classes && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
